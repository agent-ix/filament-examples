    "clause": {
      "selection": {
        "temporal": {
          "name": "StopForEachFastStart",
          "trace": {
            "lasso": {
              "prefix": [
                "drive",
                "stop"
              ],
              "loop": [
                "brake"
              ]
            }
          },
          "over": {
            "reference": {
              "population": "ix://example/rover/rovers",
              "key": "r1"
            }
          }
        }
      },
      "observations": {
        "drive": "../../rover/data/t0-driving.json",
        "stop": "../../rover/data/t3-stopped.json",
        "brake": "../../rover/data/t2-braking.json"
      }
    }
  }
