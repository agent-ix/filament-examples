// FSpec FR-140-AC-3
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function rounded using v(): Decimal[0, 2; 0, 0; nearest-away] pure { let r: Rational[-9, 9; 1, 2] = rational(5, 2) in convert<Decimal[0, 2; 0, 0; nearest-away]>(r) }
function example using v(): Boolean pure { rounded() = decimal(2, 0) }
