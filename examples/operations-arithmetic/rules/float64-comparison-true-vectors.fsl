// FSpec FR-148-AC-12, FR-148-AC-1
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure {
  let p0: Float64[nearest-even] = float64(bits: 0x0000000000000000) in
  let n0: Float64[nearest-even] = float64(bits: 0x8000000000000000) in
  let one: Float64[nearest-even] = float64(bits: 0x3ff0000000000000) in
  let pinf: Float64[nearest-even] = float64(bits: 0x7ff0000000000000) in
  let pinf2: Float64[nearest-even] = float64(bits: 0x7ff0000000000000) in
  let qnan: Float64[nearest-even] = float64(bits: 0x7ff8000000000000) in
  n0 = p0 and n0 <= p0 and p0 >= n0 and one < pinf and pinf <= pinf2 and qnan != qnan and qnan != one
}
