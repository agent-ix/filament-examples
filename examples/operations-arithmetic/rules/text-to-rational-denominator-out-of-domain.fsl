// FSpec FR-478-AC-7
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function conv using v(t: Text[0, 16; unicode-scalars]): Rational[-9, 9; 1, 9] pure { convert<Rational[-9, 9; 1, 9]>(t) }
function example using v(): Boolean pure { conv(Text("1/10")) = rational(0, 1) }
