// FSpec FR-148-AC-9
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function n using v(x: Float32[nearest-even]): Float64[nearest-even] pure { convert<Float64[nearest-even]>(x) }
function example using v(): Boolean pure { filament::value::ieee::bitIdentical(n(float32(bits: 0xffc00005)), float64(bits: 0xfff8000000000005)) }
