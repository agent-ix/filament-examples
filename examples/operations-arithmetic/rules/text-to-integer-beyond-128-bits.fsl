// FSpec FR-478-AC-1
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function conv using v(t: Text[0, 60; unicode-scalars]): Integer pure { convert<Integer>(t) }
function example using v(): Boolean pure { conv(Text("170141183460469231731687303715884105728")) = conv(Text("170141183460469231731687303715884105727")) + 1 }
