// FSpec FR-140-AC-3 (all-zero discarded digits are no rounding step)
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function rounded using v(): Decimal[-100, 100; 0, 0; exact] pure { let r: Rational[-9, 9; 1, 2] = rational(4, 2) in convert<Decimal[-100, 100; 0, 0; exact]>(r) }
function example using v(): Boolean pure { rounded() = decimal(2, 0) }
