// FSpec FR-140-AC-4
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function rounded using v(): Decimal[-100, 100; 0, 0; nearest-even] pure { let r: Rational[-99, 99; 1, 10] = rational(13, 10) in convert<Decimal[-100, 100; 0, 0; nearest-even]>(r) }
function example using v(): Boolean pure { rounded() = decimal(1, 0) }
