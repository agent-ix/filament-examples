// FSpec FR-146-AC-21
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function narrow using v(x: Int[0, 9]): Integer pure { x }
function a using v(x: Int[0, 9], y: Int[0, 9]): Integer pure { if x + y <= 9 then narrow(x + y) else 0 }
function b using v(x: Int[0, 9], y: Int[0, 9]): Integer pure { if 9 >= y + x then narrow(x + y) else 0 }
function c using v(x: Int[0, 9], y: Int[0, 9]): Integer pure { if x + y < 10 then narrow((x) + (y)) else 0 }
function d using v(x: Int[0, 9], y: Int[0, 9]): Integer pure { if x + y > 9 then 0 else narrow(x + y) }
function e using v(x: Int[0, 9], y: Int[0, 9]): Integer pure { if x - y >= 0 then narrow(x - y) else 0 }
