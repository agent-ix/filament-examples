// FSpec FR-142-AC-28
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
dimension L;
unit m: L = rational(1, 1);
unit cm: L = rational(1, 100) * m;
type Cd = Quantity<m, Decimal[-100, 100; 2, 2; exact]>;
function c using v(q: Quantity<cm>): Cd pure { convert<Cd>(q) }
function back using v(q: Cd): Quantity<m> pure { convert<Quantity<m>>(q) }
function example using v(): Boolean pure { back(c(25 cm)) = 0.25 m }
