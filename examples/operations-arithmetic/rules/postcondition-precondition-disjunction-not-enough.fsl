// FSpec FR-146-AC-18
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
object Account identity (id) { id: Int[0, 9]; balance: Int[0, 100]; population accounts; operation withdraw(amount: Int[0, 100]): Boolean modifies self.balance; }
pre Maybe using v on Account::withdraw { amount <= self.balance or amount <= 5 }
post Debited using v on Account::withdraw { self.balance = pre(self.balance) - amount }
