function d using v(q: OrderedSet<Integer>[0, 5]): Int[0, 5] pure { size<Int[0, 5]>(q) }
function e using v(q: Map<Int[0, 9], Boolean>[0, 5]): Int[0, 5] pure { size<Int[0, 5]>(q) }
