// FSpec FR-148-AC-2
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure { let one: Float64[nearest-even] = float64(bits: 0x3ff0000000000000) in let three: Float64[nearest-even] = float64(bits: 0x4008000000000000) in filament::value::ieee::bitIdentical(one / three, float64(bits: 0x3fd5555555555555)) }
