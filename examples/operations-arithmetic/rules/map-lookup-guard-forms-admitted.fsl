// FSpec FR-146-AC-20
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function a using v(m: Map<Int[0, 9], Integer>[0, 3]): Integer pure { if contains(m, 1) then m[1] else -1 }
function b using v(m: Map<Int[0, 9], Integer>[0, 3]): Integer pure { if not contains(m, 1) then -1 else m[1] }
function c using v(m: Map<Int[0, 9], Integer>[0, 3], k: Int[0, 9]): Integer pure { if contains(m, k) then m[k] else -1 }
