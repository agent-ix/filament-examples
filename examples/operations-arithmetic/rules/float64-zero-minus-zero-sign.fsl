// FSpec FR-148-AC-8
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure { let p0: Float64[nearest-even] = float64(bits: 0x0000000000000000) in let n0: Float64[nearest-even] = float64(bits: 0x8000000000000000) in filament::value::ieee::bitIdentical(n0 + n0, n0) and filament::value::ieee::bitIdentical(p0 + n0, p0) }
