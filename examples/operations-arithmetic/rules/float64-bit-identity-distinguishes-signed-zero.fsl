// FSpec FR-148-AC-5
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure { let p0: Float64[nearest-even] = float64(bits: 0x0000000000000000) in let n0: Float64[nearest-even] = float64(bits: 0x8000000000000000) in p0 = n0 and not filament::value::ieee::bitIdentical(p0, n0) }
