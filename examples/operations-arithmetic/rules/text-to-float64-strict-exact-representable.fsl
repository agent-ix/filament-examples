// FSpec FR-478-AC-9
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function conv using v(t: Text[0, 16; unicode-scalars]): Float64 pure { convert<Float64>(t) }
function example using v(): Boolean pure { filament::value::ieee::bitIdentical(conv(Text("0.25")), float64(bits: 0x3fd0000000000000)) }
