// FSpec FR-147-AC-1, FR-147-AC-4
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
profile law = "filament.value.integer-division.truncating/v1";
function example using v(): Boolean pure { ((-7) div 3) = -2 and ((-7) rem 3) = -1 and (7 div (-3)) = -2 and (7 rem (-3)) = 1 and ((-7) div (-3)) = 2 and ((-7) rem (-3)) = -1 and (7 div 3) = 2 and (7 rem 3) = 1 and 3 * ((-7) div 3) + ((-7) rem 3) = -7 and (-3) * (7 div (-3)) + (7 rem (-3)) = 7 }
