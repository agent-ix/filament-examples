// FSpec FR-148-AC-6
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure { let big: Float64[nearest-even] = float64(bits: 0x7fefffffffffffff) in filament::value::ieee::bitIdentical(big + big, float64(bits: 0x7ff0000000000000)) }
