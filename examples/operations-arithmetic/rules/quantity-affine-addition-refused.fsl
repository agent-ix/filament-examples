// FSpec FR-142-AC-2, FR-142-AC-5
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
dimension Temperature;
unit K: Temperature = rational(1, 1);
unit degC: Temperature = rational(1, 1) * K + decimal(27315, 2);
function f using v(a: Quantity<degC>, b: Quantity<degC>): Boolean pure { a + b = a }
