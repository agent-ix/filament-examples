// FSpec FR-148-AC-6
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function s using v(x: Float64[nearest-even]): Float64[nearest-even] pure { filament::value::ieee::sqrt(x) }
function example using v(): Boolean pure { filament::value::ieee::bitIdentical(s(float64(bits: 0x4010000000000000)), float64(bits: 0x4000000000000000)) }
