// FSpec FR-145-AC-1, FR-145-AC-4
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure { let q: Sequence<Integer>[0, 5] = sequence[3, 1, 4, 1, 5] in let r: Sequence<Integer>[0, 5] = filter(x in q: x > 2) in r = sequence[3, 4, 5] }
