language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile inf = "filament.temporal.infinite-trace/v1";
profile fe = "filament.temporal.event-position.false-extension/v1";
model D = "example/dial";
record Sig { p: Boolean; n: Int[0, 9]; }

probabilistic Rule using inf on D over (d: D::Dial) under every scheduler on origin { probability >= 0.5 [ eventually holds(d.n = 3) ] }
