// FSpec FR-149-AC-12
language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
object Order identity (total) { total: Int[0, 9]; population orders; }
object Other identity (total) { total: Int[0, 9]; population others; }
function f using v(a: Reference<Other>, b: Reference<Order>): Boolean pure { a = b }
