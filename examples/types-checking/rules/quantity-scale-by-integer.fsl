// FSpec FR-142-AC-41
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
dimension T;
unit s: T = rational(1, 1);
unit ms: T = rational(1, 1000) * s;
function f using v(d: Quantity<ms>, k: Int[0, 9]): Quantity<ms> pure { d * 2 }
function g using v(d: Quantity<ms>, k: Int[0, 9]): Quantity<ms> pure { 2 * d }
function h using v(d: Quantity<ms>, k: Int[0, 9]): Quantity<ms> pure { d * k }
