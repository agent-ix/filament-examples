// FSpec FR-149-AC-25
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function example using v(): Boolean pure { let p: Float64[nearest-even] = float64(bits: 0x0000000000000000) in let n: Float64[nearest-even] = float64(bits: 0x8000000000000000) in let q: Float64[nearest-even] = float64(bits: 0x7ff8000000000000) in p = n and q != q and not (q = q) }
