language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
model Arch = "example/architecture";

// Each call to a service fails 1 time in 10,000.
random Arch::Service::call(ok) ~ { true: 9999, false: 1 };
workload Traffic on Arch { weight Arch::Service::call = 1; }

// A service is up after a call exactly when the call succeeded.
post UpFollowsCall using v on Arch::Service::call { self.up = ok }

// "At least 99%" written as 99. A threshold is a probability strictly
// between 0 and 1, so the checker refuses the claim.
probabilistic UpAsPercent using ev on Arch over (s: Arch::Service) under Traffic on origin {
  probability >= 99 [ always[0,10] holds(s.up) ]
}
