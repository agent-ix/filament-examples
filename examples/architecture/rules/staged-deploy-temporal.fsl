language "ix:native" edition "1-draft";
profile v = "quire.model.complete/v1";
profile T = "quire.temporal.event-position.false-extension/v1";
model Arch = "example/architecture";

type Serving = Int[0, 10];

// Across the whole plan (five steps), the service never drops below its minimum.
temporal ServingThroughout using T over (s: Arch::Service) clock "events" on origin {
  always[0,4] holds(count<Serving>(i in s.instances: deref(i).serving) >= s.minServing)
}
