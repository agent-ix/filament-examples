language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model Arch = "example/architecture";

random Arch::Service::call(ok) ~ { true: 9999, false: 1 };

// Each call fails 1 time in 10,000, but a scheduler that keeps calling a service makes it fail with
// probability 1, so the service is not always up.
probabilistic StaysUp using ev on Arch over (s: Arch::Service) under every scheduler on origin {
  probability >= 0.9 [ always holds(s.up) ]
}
