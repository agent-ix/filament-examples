language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model Arch = "example/architecture";

// No random line: every call argument belongs to the scheduler. The scheduler that always passes
// false makes the service fail at once, so the probability under every scheduler is 0.
probabilistic NoRandomUp using ev on Arch over (s: Arch::Service) under every scheduler on origin {
  probability >= 0.99 [ always[0,10] holds(s.up) ]
}
