language "ix:native" edition "1-draft";
profile v = "quire.model.complete/v1";
profile ev = "quire.temporal.event-position.false-extension/v1";
profile inf = "quire.temporal.infinite-trace/v1";
model Arch = "example/architecture";

// Each service stays up for the next 10 steps with probability at least 0.99.
probabilistic CheckoutAvailable using ev on Arch over (s: Arch::Service) under every scheduler on origin {
  probability >= 0.99 [ always[0,10] holds(s.up) ]
}
