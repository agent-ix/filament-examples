language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model Arch = "example/architecture";

random Arch::Service::call(ok) ~ { true: 9999, false: 1 };

// A service that is up already satisfies eventually-up, so the claim holds with probability 1
// whatever the scheduler picks; each call fails 1 time in 10,000.
probabilistic ComesUp using inf on Arch over (s: Arch::Service) under every scheduler on origin {
  probability >= 0.9 [ eventually holds(s.up) ]
}
