language "ix:native" edition "1-draft";
profile v = "quire.model.complete/v1";
profile ev = "quire.temporal.event-position.false-extension/v1";
profile inf = "quire.temporal.infinite-trace/v1";
model Arch = "example/architecture";

random Arch::Service::call(ok) ~ { true: 9999, false: 1 };

// No confidence clause: only exact computation decides this claim.
probabilistic ComesUp using inf on Arch over (s: Arch::Service) under every scheduler on origin {
  probability >= 0.9 [ eventually holds(s.up) ]
}
