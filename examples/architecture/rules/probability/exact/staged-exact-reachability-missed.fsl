language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model Arch = "example/architecture";

random Arch::Service::call(ok) ~ { true: 9999, false: 1 };

// A service that calls again and again fails at some call with probability 1, so
// under the scheduler that keeps calling it is not always up: the claim misses.
// No confidence clause: only exact computation decides this claim.
probabilistic StaysUp using inf on Arch over (s: Arch::Service) under every scheduler on origin {
  probability >= 0.9 [ always holds(s.up) ]
}
