language "ix:native" edition "1-draft";
profile inf = "filament.temporal.infinite-trace/v1";
model Rover = "example/rover";

// If the rover keeps sampling, it is stopped again and again. The fairness
// constraint needs to know when `sample` was enabled, which a recorded trace
// does not say.
temporal KeepsSampling using inf over (r: Rover::Rover) clock "model-steps" on origin {
  fair weak Rover::Rover::sample;
  always eventually holds(r.stopped)
}
