          "file": "../model/rover.semantic-ir.json",
          "authority": "example",
          "identity": "example:rover/model",
          "document": "model",
          "formal_revision": 1
        }
      }
    ],
    "program": {
      "source": {
        "file": "../rules/time-operators.fsl",
        "authority": "example",
        "identity": "example:rover/time-operators",
        "document": "timeoperators",
        "formal_revision": 1
      }
    },
    "clause": {
      "selection": {
        "temporal": {
          "name": "EventuallyStopped",
          "trace": {
            "lasso": {
              "prefix": [
                "t0-driving",
                "t1-lidar-lost"
              ],
              "loop": [
                "u2-still-driving"
              ]
            }
          },
          "over": {
            "reference": {
              "population": "ix://example/rover/rovers",
              "key": "r1"
            }
          }
        }
      },
      "observations": {
        "t0-driving": "../data/t0-driving.json",
        "t1-lidar-lost": "../data/t1-lidar-lost.json",
        "u2-still-driving": "../data/u2-still-driving.json"
      }
    }
