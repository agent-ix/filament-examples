language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
model Shop = "example/shop";

// A paid order has been charged its full total.
// The model has no field `paid`: the field is `charged`.
invariant PaidInFull using v on Shop::Order at current {
  self.status = Shop::OrderStatus::Paid implies self.paid = self.total
}
