language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";

type Cents = Int[0, 1000000];
type Qty = Int[1, 99];

record LineItem { price: Cents; qty: Qty; }

function itemTotal using v(price: Cents, qty: Qty): Int[0, 99000000] pure {
  let item = LineItem { price: price, qty: qty } in item.price * item.qty
}
