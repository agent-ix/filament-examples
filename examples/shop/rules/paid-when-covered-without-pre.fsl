language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
model Shop = "example/shop";

// A charge that covers the rest of the total leaves the order Paid,
// written without pre(): self.charged is read after the call, so the
// amount of the charge is counted twice.
post PaidWhenCoveredWithoutPre using v on Shop::Order::charge {
  self.charged + amount >= self.total implies self.status = Shop::OrderStatus::Paid
}
