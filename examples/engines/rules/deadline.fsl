language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile tc = "filament.temporal.complete/v1";
profile t = "filament.temporal.timed/v1";
model Rover = "example/rover-deadline";

dimension Time;
unit s : Time = rational(1, 1);
unit ms : Time = rational(1, 1000) * s;
time Rover dense unit ms;

// A degraded rover brakes once its clock has run 50 ms and must brake by 100 ms. Braking restarts the clock.
pre BrakeWhenDegraded using v on Rover::Rover::brake {
  self.mode = Rover::Mode::Degraded and self.x >= 50 ms
}
post BrakeEntersSafeStop using v on Rover::Rover::brake {
  self.mode = Rover::Mode::SafeStop and self.x = 0 ms
}
time invariant DegradedBrakesBy100ms when { self.mode = Rover::Mode::Degraded } { self.x <= 100 ms }

// A braked rover halts once its clock has run 50 ms and must halt by 100 ms.
pre HaltInSafeStop using v on Rover::Rover::halt {
  self.mode = Rover::Mode::SafeStop and not self.stopped and self.x >= 50 ms
}
post HaltStops using v on Rover::Rover::halt {
  self.stopped
}
time invariant SafeStopHaltsBy100ms when { self.mode = Rover::Mode::SafeStop and not self.stopped } { self.x <= 100 ms }

// Braking takes 50 to 100 ms and halting 50 to 100 ms, so the earliest stop is at 100 ms and the latest at 200 ms.
temporal StopsWithin200ms using t over (r: Rover::Rover) clock "model-time" on origin { eventually[0 ms, 200 ms] holds(r.stopped) }
temporal StopsWithin199ms using t over (r: Rover::Rover) clock "model-time" on origin { eventually[0 ms, 199 ms] holds(r.stopped) }
temporal StopsWithin201ms using t over (r: Rover::Rover) clock "model-time" on origin { eventually[0 ms, 201 ms] holds(r.stopped) }
temporal NotStoppedBefore100ms using t over (r: Rover::Rover) clock "model-time" on origin { always[0 ms, 99 ms] holds(not r.stopped) }
temporal NotStoppedBefore150ms using t over (r: Rover::Rover) clock "model-time" on origin { always[0 ms, 150 ms] holds(not r.stopped) }
