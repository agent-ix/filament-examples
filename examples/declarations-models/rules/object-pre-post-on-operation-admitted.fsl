// FSpec FR-019-AC-6
language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
object Order identity (total) { total: Int[0, 9]; population orders; operation bump(): Boolean modifies self.total; }
pre CanBump using v on Order::bump { self.total < 9 }
post Bumped using v on Order::bump { self.total <= 9 }
