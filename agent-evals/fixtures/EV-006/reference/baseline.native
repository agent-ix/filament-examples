language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile pp = "filament.protocol.finite-global/v1";
model M = "eval/protocol-fill";

pre IncPre using v on M::Cell::inc { self.v < 3 }
post IncPost using v on M::Cell::inc { self.v - pre(self.v) = 1 }
pre TwoPre using v on M::Cell::setTwo { self.v = 0 }
post TwoPost using v on M::Cell::setTwo { self.v = 2 }

protocol Fill using pp over (k: M::Cell) on origin {
  role w on M::Cell;
  run sequence Main {
    parallel Both {
      branch left attempt A by w on M::Cell::inc contracts [IncPre, IncPost] as (a: Boolean) { true };
      branch right attempt B by w on M::Cell::setTwo contracts [TwoPre, TwoPost] as (b: Boolean) { true };
    } join all [left, right];
  }
  finish Done as (d: Boolean) { true };
}
